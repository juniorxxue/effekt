// One abstraction is checked outside either handler, then instantiated twice.
def main(): Bool = {
  val invoke = capfun (c: { def ask(): Int / (Int => Bool); }) {
    fun local[c] (u: Unit): Int / (Int => Bool) {
      c.ask()
    }
  };
  val first = try {
    invoke{cap(h)}()
  } with h: Bool {
    def ask(arg: Unit): Int / (Int => Bool) = {
      val n = resume(42);
      zero(n)
    }
    return x => {
      x
    }
  };
  try {
    invoke{cap(h)}()
  } with h: Bool {
    def ask(arg: Unit): Int / (Int => Bool) = {
      val n = resume(0);
      zero(n)
    }
    return x => {
      if (first) {
        1
      } else {
        x
      }
    }
  }
}
