// Passing a capability preserves its identity and full operation answer contract.
def main(): Bool = {
  try {
    def local invoke(c: cap(h)): Int / (Int => Bool) = {
      c.ask()
    }
    invoke(cap(h))
  } with h: Bool {
    def ask(arg: Unit): Int / (Int => Bool) = {
      val n = resume(42);
      zero(n)
    }
    return x => {
      x
    }
  }
}
