// The helper's callback contract names its bound capability, not a concrete h.
def main(): Bool = {
  val apply = capfun (c: { def ask(): Int / (Int => Bool); }) {
    fun local[c] (f: (local[c] (Unit) => Int / (Int => Bool))): Int / (Int => Bool) {
      f()
    }
  };
  try {
    apply{cap(h)}(fun local (u: Unit): Int / (Int => Bool) {
      h.ask()
    })
  } with h: Bool {
    def ask(arg: Unit): Int / (Int => Bool) = {
      val n = resume(42);
      zero(n)
    }
    return x => {
      x
    }
  }
}
