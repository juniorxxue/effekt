// coar d293ee6759bd285f4a496b727f1df85e70f30f3e: io-read-1-SAT.ml
// Read carries its remaining count as explicit annotation context. The
// handler still consumes one list element per read and aborts on an empty list.
data ListInt { Nil(); Cons(head: Int, tail: ListInt) }
data Result { Ok(); Err() }
measure readOutcome(xs: ListInt, n: Int): Result {
  case Nil() => if n <= 0 then Ok() else Err();
  case Cons(h,t) => if n <= 0 then Ok() else readOutcome(t, n - 1);
}
def main(): Bool = {
  def test(n: {m: Int | m == 0}): ((input: {xs: ListInt | true}) => {r: Result | r == Ok()}) = {
    fun (input: {xs: ListInt | true})[R: Reg]: {r: Result | r == Ok()} {
      type StateRegion = ((Unit) =>[R] Unit);
      val run = try {
        def rec go(m: Int) at [inputHandler]: (v: Result) /
          (((xs: ListInt) =>[StateRegion] {r: Result | r == v}) =>
           ((xs: ListInt) =>[StateRegion] {r: Result | r == readOutcome(xs, m)})) = {
          if (m <= 0) { Ok() } else { inputHandler.read(m); go(m - 1) }
        }
        go(n)
      } with inputHandler: ((xs: ListInt) =>[R] {r: Result | r == readOutcome(xs, n)}) {
        def read(remaining: {m: Int | m > 0}): Int /
          (((xs: ListInt) =>[R] {r: Result | r == readOutcome(xs, remaining - 1)}) =>
           ((xs: ListInt) =>[R] {r: Result | r == readOutcome(xs, remaining)})) = {
          fun (xs: ListInt) at [R]: {r: Result | r == readOutcome(xs, remaining)} {
            match (xs) {
              case Nil() => { Err() }
              case Cons(h, t) => { val next = resume(h); next(t) }
            }
          }
        }
        return v => { fun (xs: ListInt) at [R]: {r: Result | r == v} { v } }
      };
      run(input)
    }
  }
  val readList = test(0);
  val result = readList(Cons(9, Nil()));
  result == Ok()
}
