// Pinned coar ARM: queue-2-SAT.ml. The queue remains a FIFO state-passing handler.
data ListInt { Nil(); Cons(head: Int, tail: ListInt) }
data OptionInt { None(); Some(value: Int) }
measure append(xs: ListInt, ys: ListInt): ListInt {
  case Nil() => ys;
  case Cons(h,t) => Cons(h,append(t,ys));
}
measure headOf(xs: ListInt): OptionInt {
  case Nil() => None(); case Cons(h,t) => Some(h);
}
measure secondOf(xs: ListInt): OptionInt {
  case Nil() => None(); case Cons(h,t) => headOf(t);
}
def main(): Bool = {
  def rec appendList(xs: ListInt): ((ys: ListInt) => {r: ListInt | r == append(xs,ys)}) = {
    fun (ys: ListInt): {r: ListInt | r == append(xs,ys)} {
      match (xs) {
        case Nil() => { ys }
        case Cons(h,t) => { val more = appendList(t); val tail = more(ys); Cons(h,tail) }
      }
    }
  }
  def test(init: {xs: ListInt | xs != Nil()})[R: Reg]: {r: OptionInt | r != None()} = {
    type StateRegion = ((Unit) =>[R] Unit);
    val run = try {
      queue.enqueue(42);
      queue.get(1);
      queue.get(2)
    } with queue: ((xs: ListInt) =>[R] {r: OptionInt | r == secondOf(append(xs,Cons(42,Nil())))}) {
      def get(ctx: {i: Int | i == 1 || i == 2}): (v: OptionInt) /
        (((xs: ListInt) =>[R] {r: OptionInt | r == (if ctx == 1 then headOf(xs) else v)}) =>
         ((xs: ListInt) =>[R] {r: OptionInt | r == (if ctx == 1 then secondOf(xs) else headOf(xs))})) = {
        fun (xs: ListInt) at [R]: {r: OptionInt | r == (if ctx == 1 then secondOf(xs) else headOf(xs))} {
          match (xs) {
            case Nil() => { val next = resume(None()); next(Nil()) }
            case Cons(h,t) => { val next = resume(Some(h)); next(t) }
          }
        }
      }
      def enqueue(value: Int): Unit /
        (((xs: ListInt) =>[R] {r: OptionInt | r == secondOf(xs)}) =>
         ((xs: ListInt) =>[R] {r: OptionInt | r == secondOf(append(xs,Cons(value,Nil())))})) = {
        fun (xs: ListInt) at [R]: {r: OptionInt | r == secondOf(append(xs,Cons(value,Nil())))} {
          val next = resume(); val push = appendList(xs); val updated = push(Cons(value,Nil())); next(updated)
        }
      }
      return v => { fun (xs: ListInt) at [R]: {r: OptionInt | r == v} { v } }
    };
    run(init)
  }
  val result = test(Cons(7,Nil()));
  result == Some(42)
}
