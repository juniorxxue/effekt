// Pinned coar ARM: modulus-UNSAT.ml.
// mu is specialized to the benchmark's f. It still calls the supplied sequence
// through Call, multiplies its result by zero, and tracks the largest index.
def main(): Bool = {
  def test(r: Int) at [top]: ((a: ((x: Int) => {v: Int | x != 10 || v == r})) =>[top]
    ((b: ((x: Int) => {v: Int | x != 10 || v == r})) =>[top] {v: Bool | v == false})) = {
    fun (a: ((x: Int) => {v: Int | x != 10 || v == r})) at [top]:
      ((b: ((x: Int) => {v: Int | x != 10 || v == r})) =>[top] {v: Bool | v == false}) {
      fun (b: ((x: Int) => {v: Int | x != 10 || v == r})) at [top]: {v: Bool | v == false} {
        def mu(sequence: ((x: Int) => {v: Int | x != 10 || v == r})) at [top]: {v: Int | v == 10} = {
          val run = try {
            val value = calls.call(10); 0 * value
          } with calls: ((i: Int) =>[top] {v: Int | v == (if i >= 10 then i else 10)}) {
            def call(n: Int): Int /
              (((i: Int) =>[top] {v: Int | v == i}) =>
               ((i: Int) =>[top] {v: Int | v == (if i >= n then i else n)})) = {
              fun (i: Int) at [top]: {v: Int | v == (if i >= n then i else n)} {
                val j = if (i >= n) { i } else { n };
                val value = sequence(n); val next = resume(value); next(j)
              }
            }
            return unused => { fun (i: Int) at [top]: {v: Int | v == i} { i } }
          };
          run(0)
        }
        val left = mu(a); val right = mu(b); left == right
      }
    }
  }
  val withA = test(7);
  val withB = withA(fun (x: Int): {v: Int | x != 10 || v == 7} { 7 });
  withB(fun (x: Int): {v: Int | x != 10 || v == 7} { if (x == 10) { 7 } else { 11 } })
}
