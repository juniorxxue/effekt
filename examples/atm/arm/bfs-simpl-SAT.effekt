// Pinned coar ARM: bfs-simpl-SAT.ml.
// Specialization to the benchmark's one Select: the private mutable queue is
// threaded through runNext; Failure handling is moved from retc to the caller
// of the dequeued continuation. FIFO order and actual resumptions are retained.
// Select's argument supplies its two expected results as annotation context.
data Result { Failure(); Success(value: Int) }
data Jobs {
  Empty();
  Job(left: Result, right: Result,
      run: ((b: Bool) =>[top] {r: Result | r == (if b then left else right)}),
      choice: Bool, tail: Jobs)
}
measure outcome(q: Jobs): Result {
  case Empty() => Failure();
  case Job(l,r,k,b,t) => if (if b then l else r) == Failure() then outcome(t) else (if b then l else r);
}
measure append(q: Jobs, rest: Jobs): Jobs {
  case Empty() => rest;
  case Job(l,r,k,b,t) => Job(l,r,k,b,append(t,rest));
}
def main(): Bool = {
  def rec appendJobs(q: Jobs) at [top]: ((rest: Jobs) =>[top] {r: Jobs | r == append(q,rest)}) = {
    fun (rest: Jobs) at [top]: {r: Jobs | r == append(q,rest)} {
      match (q) {
        case Empty() => { rest }
        case Job(l,r,k,b,t) => { val push = appendJobs(t); val tail = push(rest); Job(l,r,k,b,tail) }
      }
    }
  }
  def rec runNext(q: Jobs) at [top]: {r: Result | r == outcome(q)} = {
    match (q) {
      case Empty() => { Failure() }
      case Job(l,r,k,b,t) => {
        val result = k(b);
        match (result) {
          case Success(x) => { Success(x) }
          case Failure() => { runNext(t) }
        }
      }
    }
  }
  def test(n: Int) at [top]: {r: Bool | r == true} = {
    val left = Success(n);
    val right = Success(-n);
    val result = try {
      val select = search.select((left,right));
      val cand = if (select) { n } else { -n };
      if (cand * cand == n * n) { Success(cand) } else { Failure() }
    } with search: {r: Result | r == (if left == Failure() then right else left)} {
      def select(ctx: (Result,Result)): (b: Bool) /
        ({r: Result | r == (if b then fst(ctx) else snd(ctx))} =>
         {r: Result | r == (if fst(ctx) == Failure() then snd(ctx) else fst(ctx))}) = {
        val callback = fun (b: Bool) at [top]: {r: Result | r == (if b then fst(ctx) else snd(ctx))} { resume(b) };
        val enqueueFirst = appendJobs(Empty());
        val first = enqueueFirst(Job(fst(ctx),snd(ctx),callback,true,Empty()));
        val enqueueSecond = appendJobs(first);
        val queue = enqueueSecond(Job(fst(ctx),snd(ctx),callback,false,Empty()));
        runNext(queue)
      }
      return r => { r }
    };
    match (result) { case Success(b) => { b == n || b == -n } case Failure() => { false } }
  }
  test(7)
}
