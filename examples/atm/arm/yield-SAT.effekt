// Pinned coar ARM: yield-SAT.ml. Susp stores the actual captured continuation.
// The iterator helpers use exact top-region arrows.
data Tree { Leaf(value: Int); Node(left: Tree, right: Tree) }
data Iterator {
  Result(tree: {t: Tree | allEqual(t,1)});
  Susp(value: {x: Int | x == 0}, next: ((y: {i: Int | i == value + 1}) =>[top] Iterator))
}
measure allEqual(t: Tree, n: Int): Bool {
  case Leaf(x) => x == n;
  case Node(l,r) => allEqual(l,n) && allEqual(r,n);
}
def main(): Bool = {
  def rec increment(it: Iterator) at [top]: {t: Tree | allEqual(t,1)} = {
    match (it) {
      case Result(t) => { t }
      case Susp(x,k) => { val next = k(x+1); increment(next) }
    }
  }
  def test(t: {tree: Tree | allEqual(tree,0)}) at [top]: {tree: Tree | allEqual(tree,1)} = {
    val iterator = try {
      def rec depthWalk(tree: {t: Tree | allEqual(t,0)}) at [yields]: {t: Tree | allEqual(t,1)} / (Iterator => Iterator) = {
        match (tree) {
          case Leaf(a) => { val b = yields.emit(a); Leaf(b) }
          case Node(l,r) => { val left = depthWalk(l); val right = depthWalk(r); Node(left,right) }
        }
      }
      depthWalk(t)
    } with yields: Iterator {
      def emit(x: {i: Int | i == 0}): {y: Int | y == x + 1} / (Iterator => Iterator) = {
        Susp(x,fun (y: {i: Int | i == x + 1}) at [top]: Iterator { resume(y) })
      }
      return result => { Result(result) }
    };
    increment(iterator)
  }
  val result = test(Node(Leaf(0),Node(Leaf(0),Leaf(0))));
  result == Node(Leaf(1),Node(Leaf(1),Leaf(1)))
}
