// Accepted result-type-polymorphic example; the result is 42.
// Each callback declares its call ATC; the helper instantiates it with [].
// The symbolic-distance inference failure is infer/polymorphic-outer-call.effekt.
// Mock descriptors/read/close; no operating-system file access.
def main(): Int = {
  def readInt(c: Int): Int = { c }
  def closeFile(c: Int): Unit = { () }
  val file = fun [R] {
    fun (c: Int) {
      fun (body: forall cap f: {
        def read(Unit): Int / (R => R);
        def close(Unit): Unit / (R => R);
      }. ((Unit)[K: ATC(dist(path(f)))] => R / (K[R] => K[R]) at {f})) {
        try {
          body{cap(h)}[[]]()
        } with h {
          def read(u: Unit): Int / (R => R) = {
            val x = readInt(c);
            resume(x)
          }
          def close(u: Unit): Unit / (R => R) = {
            closeFile(c);
            resume()
          }
          return x => { x }
        }: R
      }
    }
  };
  val readNumber = file[Int](42);
  val n = readNumber(capfun (f: {
    def read(Unit): Int / (Int => Int);
    def close(Unit): Unit / (Int => Int);
  }) {
    fun (u: Unit)[K: ATC(dist(path(f)))]: Int / (K[Int] => K[Int]) {
      val x = f.read[path(f); K]();
      f.close[path(f); K]();
      x
    }
  });
  val checkNumber = file[Bool](35);
  val ok = checkNumber(capfun (f: {
    def read(Unit): Int / (Bool => Bool);
    def close(Unit): Unit / (Bool => Bool);
  }) {
    fun (u: Unit)[K: ATC(dist(path(f)))]: Bool / (K[Bool] => K[Bool]) {
      val x = f.read[path(f); K]();
      f.close[path(f); K]();
      x == 35
    }
  });
  if (ok) { n } else { 0 }
}
