// The outer abstraction opens an unknown tail. The inner abstraction retains
// its abstract outer capability and is instantiated immediately inside it.
def main(): Bool = {
  val both = capfun (c: { def ask(): Int / (Int => Bool); }) {
    capfun here (d: { def bump(): Int / (Int / (Int => Bool) => Int / (Int => Bool)); }) {
      fun (u: Unit): Int / (Int / (Int => Int) => Int / (Int => Bool)) {
        val a = d.bump();
        val b = c.ask();
        (a + b)
      }
    }
  };
  try {
    try {
      val local = both{cap(outer)}{cap(inner)};
      local()
    } with inner: Int / (Int => Bool) {
      def bump(x: Unit): Int / (Int / (Int => Bool) => Int / (Int => Bool)) = {
        resume(20)
      }
      return x => {
        x
      }
    }
  } with outer: Bool {
    def ask(x: Unit): Int / (Int => Bool) = {
      val n = resume(22);
      zero(n)
    }
    return x => {
      x
    }
  }
}
